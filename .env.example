# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Neon pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Neon direct connection (used by prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Clinic wall-clock timezone. Drives "today", slot generation and revenue windows.
# CLINIC_TIMEZONE="Asia/Dhaka"
# NEXT_PUBLIC_CLINIC_TIMEZONE="Asia/Dhaka"
